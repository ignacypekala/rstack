CC = gcc
LDFLAGS = -shared -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc \
-Wl,--wrap=reallocarray -Wl,--wrap=free -Wl,--wrap=strdup -Wl,--wrap=strndup
CFLAGS = -Wall -Wextra -Wno-implicit-fallthrough -std=gnu23 -fPIC -O2

.PHONY: clean all
all: librstack.so

librstack.so: rstack.o memory_tests.o rstack_container.o rstack_delete.o \
rstack_read.o
	$(CC) $^ -o $@ $(LDFLAGS) 

rstack_%: rstack_%.o librstack.so
	$(CC) $^ -o $@ -L . -l rstack -Wl,-rpath,'.'

%.o: %.c %.h types.h
	$(CC) -c $< -o $@ $(CFLAGS)

# Fallback goal for modules with no header file
%.o: %.c types.h
	$(CC) -c $< -o $@ $(CFLAGS)

clean:
	rm -f *.o rstack_example librstack.so 
